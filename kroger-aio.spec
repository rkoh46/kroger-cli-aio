# PyInstaller spec for kroger-aio
# Builds a Windows .exe with all Python deps bundled.
# Playwright browser installs automatically on first run via Playwright.

from PyInstaller.utils.hooks import collect_data_files, collect_submodules
import os

# Collect all Playwright data files (essential for browser automation)
pw_data = collect_data_files('playwright')
pw_impl_data = collect_data_files('playwright._impl')

a = Analysis(
    ['kroger-aio-run.py'],
    pathex=[os.getcwd(), 'src'],
    binaries=[],
    datas=pw_data + pw_impl_data,
    hiddenimports=[
        'kroger_aio',
        'kroger_aio.cli',
        'kroger_aio.browser',
        'kroger_aio.coupons',
        'kroger_aio.account',
        'kroger_aio.survey',
        'kroger_aio.config',
        'typer',
        'typer._completion_shared',
        'typer._context',
        'typer._models',
        'typer._paramtypes',
        'typer._terminal',
        'rich',
        'rich._cell_widths',
        'rich._emoji_codes',
        'rich._log_render',
        'rich._lru_cache',
        'rich._palettes',
        'rich._ratio',
        'rich._stack',
        'rich._spinners',
        'rich._windows',
        'rich.align',
        'rich.ansi',
        'rich.bar',
        'rich.box',
        'rich.cells',
        'rich.columns',
        'rich.color',
        'rich.color_triplet',
        'rich.console',
        'rich.containers',
        'rich.control',
        'rich.default_styles',
        'rich.emoji',
        'rich.errors',
        'rich.file_proxy',
        'rich.highlighter',
        'rich.json',
        'rich.lexer',
        'rich.markdown',
        'rich.markup',
        'rich.measure',
        'rich.padding',
        'rich.panel',
        'rich.path',
        'rich.pretty',
        'rich.pprint',
        'rich.progress',
        'rich.prompt',
        'rich.protocol',
        'rich.region',
        'rich.repr',
        'rich.rule',
        'rich.scope',
        'rich.segment',
        'rich.style',
        'rich.syntax',
        'rich.table',
        'rich.terminal_theme',
        'rich.text',
        'rich.theme',
        'rich.themes',
        'rich.traceback',
        'rich.tree',
        'playwright',
        'playwright.sync_api',
    ],
    hookspath=[],
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='kroger-aio',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=True,
    icon=None,
    target_arch=None,
    disable_windowed_traceback=False,
)

collected = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=True,
    name='kroger-aio-win',
)
